{
  "expo": {
    "name": "Bible and Conflict of the Ages",
    "slug": "bible-and-conflict-of-the-ages",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "bibleandconflict",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tryjesusmedia.bibleandconflict",
      "buildNumber": "4",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tryjesusmedia.bibleandconflict",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-padded.png",
        "backgroundColor": "#010C18"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#010C18"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa359745-0c6d-41ca-adb4-444b4417d73e"
      }
    },
    "owner": "try-jesus-media"
  }
}
