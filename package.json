{
  "name": "bible-and-conflict-of-the-ages",
  "version": "1.0.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-conflict-plan.mjs",
    "test:bible": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-bible-reader.mjs",
    "test:progress": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-conflict-progress.mjs",
    "test:rewards": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-conflict-rewards.mjs",
    "test:ui": "node scripts/test-ui-contract.mjs",
    "test:site-parity": "node scripts/test-site-parity.mjs",
    "test": "npm run test:plan && npm run test:bible && npm run test:progress && npm run test:rewards && npm run test:ui && npm run test:site-parity && npm run test:badges",
    "test:auth-callback": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-auth-callback.mjs",
    "test:account-isolation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-account-isolation.mjs",
    "test:badges": "node scripts/test-reading-badges.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.23",
